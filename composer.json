{
    "name": "netsolutions/gestion",
    "description": "Gestion des demandes d'intervention des clients de NetSolutions (TP PHP2Shell, BTS SIO SLAM)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-pdo_sqlite": "*",
        "phpmailer/phpmailer": "6.4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
